{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-qa-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["resultType", "answerBasis", "text", "citations", "refusalReason", "sourceConflict"],
  "properties": {
    "resultType": {"type": "string", "enum": ["ANSWER", "REFUSAL"]},
    "answerBasis": {"type": "string", "enum": ["BUSINESS_RULE", "CURRENT_IMPLEMENTATION", "MIXED"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 12000},
    "citations": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    },
    "refusalReason": {
      "type": ["string", "null"],
      "enum": [null, "INSUFFICIENT_EVIDENCE", "CODE_SNAPSHOT_NOT_INDEXED", "OUT_OF_SCOPE", "SOURCE_CONFLICT", "AGENT_CITATION_INVALID", "OUTPUT_POLICY_VIOLATION"]
    },
    "sourceConflict": {"type": "boolean"}
  }
}
