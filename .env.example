# 仅用于本机开发示例，请在非本地环境中替换密码。
LOREDOCK_DB_NAME=loredock
LOREDOCK_DB_USER=loredock
LOREDOCK_DB_PASSWORD=change_me_local_only
LOREDOCK_DB_PORT=5432
LOREDOCK_DB_URL=jdbc:postgresql://localhost:5432/loredock
LOREDOCK_BACKEND_PORT=8080
LOREDOCK_FRONTEND_PORT=5173
LOREDOCK_STORAGE_ROOT=./data/objects

# 代码快照原始 ZIP 保存在对象根；临时工作目录与 Lucene 索引目录必须彼此隔离。
LOREDOCK_CODE_SNAPSHOT_WORK_ROOT=./data/work/code
LOREDOCK_CODE_SNAPSHOT_INDEX_ROOT=./data/indexes/code

# 固定 Web 账号：用户名和显示名可自定义，密码只配置 BCrypt 哈希。
# 占位值不是可用凭据；未替换时后端会拒绝启动。
LOREDOCK_ADMIN_USERNAME=replace_with_admin_username
LOREDOCK_ADMIN_DISPLAY_NAME=管理员
LOREDOCK_ADMIN_PASSWORD_HASH='replace_with_bcrypt_hash'
LOREDOCK_MEMBER_USERNAME=replace_with_member_username
LOREDOCK_MEMBER_DISPLAY_NAME=组内成员
LOREDOCK_MEMBER_PASSWORD_HASH='replace_with_bcrypt_hash'

# MCP 使用独立高熵 Bearer Token。只读 Token 只能查询，写 Token还可向待处理草稿池追加 Markdown。
# Token 只通过部署 secret 或本机未提交的 .env 注入，不写入日志、知识文档或仓库。
LOREDOCK_MCP_ENABLED=true
LOREDOCK_MCP_READ_TOKEN=replace_with_high_entropy_read_token
LOREDOCK_MCP_WRITE_TOKEN=replace_with_high_entropy_write_token

# Web 会话为单实例内存会话；非 HTTPS 本地开发保持 false，生产 HTTPS 必须为 true。
LOREDOCK_WEB_SESSION_TIMEOUT_SECONDS=1800
LOREDOCK_WEB_COOKIE_SECURE=false

# 演示数据只在 demo/test profile 且此开关为 true 时准备。
SPRING_PROFILES_ACTIVE=demo
LOREDOCK_DEMO_SEED_ENABLED=false

# 后台任务资源上限
LOREDOCK_JOB_CORE_POOL_SIZE=2
LOREDOCK_JOB_MAX_POOL_SIZE=4
LOREDOCK_JOB_QUEUE_CAPACITY=32
LOREDOCK_JOB_SHUTDOWN_AWAIT=30s
LOREDOCK_JOB_STALE_HEARTBEAT=5m

# Agent 默认关闭。启用时同时把 chat provider 设为 openai；密钥只从部署 secret 或本机未提交的 .env 注入。
# 模型使用 OpenAI 兼容入口；MVP 不允许请求覆盖模型、端点或运行上限。
LOREDOCK_AGENT_ENABLED=false
LOREDOCK_AGENT_CHAT_PROVIDER=none
LOREDOCK_AGENT_MODEL_NAME=deepseek-v4-flash
LOREDOCK_AGENT_MODEL_BASE_URL=https://api.deepseek.com
LOREDOCK_AGENT_MODEL_API_KEY=replace_with_deployment_secret
LOREDOCK_AGENT_MODEL_CONNECT_TIMEOUT=5s
LOREDOCK_AGENT_MODEL_READ_TIMEOUT=60s
LOREDOCK_AGENT_MODEL_MAX_RETRIES=1
LOREDOCK_AGENT_MAX_STEPS=8
LOREDOCK_AGENT_MAX_MODEL_CALLS=8
LOREDOCK_AGENT_CURATION_MAX_TOOL_CALLS=48
LOREDOCK_AGENT_CURATION_MAX_MODEL_CALLS=24
LOREDOCK_AGENT_TOTAL_TIMEOUT=90s
LOREDOCK_AGENT_MAX_RESULTS_PER_TOOL=10
LOREDOCK_AGENT_MAX_SNIPPET_CHARACTERS=2000
LOREDOCK_AGENT_MAX_CONTEXT_CHARACTERS=24000
LOREDOCK_AGENT_MAX_ANSWER_CHARACTERS=8000
LOREDOCK_AGENT_MAX_EVENTS=200
LOREDOCK_AGENT_MINIMUM_RELEVANCE=0.20
LOREDOCK_AGENT_EXECUTOR_CORE_POOL_SIZE=2
LOREDOCK_AGENT_EXECUTOR_MAX_POOL_SIZE=4
LOREDOCK_AGENT_EXECUTOR_QUEUE_CAPACITY=16
LOREDOCK_AGENT_EXECUTOR_SHUTDOWN_AWAIT=30s

# 问答 SSE 推送与执行线程资源上限。
LOREDOCK_QA_SSE_HEARTBEAT_INTERVAL=15s
LOREDOCK_QA_SSE_MAX_DURATION=6m
LOREDOCK_QA_SSE_BATCH_SIZE=200
LOREDOCK_QA_SSE_CORE_POOL_SIZE=2
LOREDOCK_QA_SSE_MAX_POOL_SIZE=8
LOREDOCK_QA_SSE_QUEUE_CAPACITY=32
LOREDOCK_QA_SSE_SHUTDOWN_AWAIT=10s

# multipart 传输上限需要覆盖代码快照；知识导入仍由下方更小的业务上限约束。
LOREDOCK_MULTIPART_MAX_FILE_SIZE=100MB
LOREDOCK_MULTIPART_MAX_REQUEST_SIZE=101MB

# 知识文档导入业务上限。
LOREDOCK_KNOWLEDGE_IMPORT_MAX_UPLOAD_SIZE=20MB
LOREDOCK_KNOWLEDGE_IMPORT_MAX_ARCHIVE_ENTRIES=200
LOREDOCK_KNOWLEDGE_IMPORT_MAX_ENTRY_UNCOMPRESSED_SIZE=2MB
LOREDOCK_KNOWLEDGE_IMPORT_MAX_ARCHIVE_UNCOMPRESSED_SIZE=50MB
LOREDOCK_KNOWLEDGE_IMPORT_MAX_COMPRESSION_RATIO=100

# T5 中文 Embedding 只读取运维人员离线准备的本地资源，不会在启动或查询时联网下载。
# 示例路径为部署目录内的相对 file URI；模型摘要是公开锁定产物的 SHA-256，不是凭据。
LOREDOCK_KNOWLEDGE_EMBEDDING_MODEL_ID=BAAI/bge-small-zh-v1.5
LOREDOCK_KNOWLEDGE_EMBEDDING_MODEL_URI=file:./models/bge-small-zh-v1.5/model.onnx
LOREDOCK_KNOWLEDGE_EMBEDDING_TOKENIZER_URI=file:./models/bge-small-zh-v1.5/tokenizer.json
LOREDOCK_KNOWLEDGE_EMBEDDING_MODEL_SHA256=3a40c6eab3abdf2bd07651031a36038c2dfaf4ebb8d62ddc78f2324b2ff4389a
LOREDOCK_KNOWLEDGE_EMBEDDING_OUTPUT_NAME=sentence_embedding
LOREDOCK_KNOWLEDGE_EMBEDDING_MAX_TOKENS=512
LOREDOCK_KNOWLEDGE_EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# 代码快照 ZIP 与检索硬上限。上传上限不可配置为超过 100 MiB。
LOREDOCK_CODE_ENABLED=false
LOREDOCK_CODE_SNAPSHOT_MAX_UPLOAD_SIZE=100MB
LOREDOCK_CODE_SNAPSHOT_MAX_ARCHIVE_ENTRIES=50000
LOREDOCK_CODE_SNAPSHOT_MAX_ARCHIVE_ENTRY_UNCOMPRESSED_SIZE=100MB
LOREDOCK_CODE_SNAPSHOT_MAX_INDEXED_FILE_SIZE=2MB
LOREDOCK_CODE_SNAPSHOT_MAX_ARCHIVE_UNCOMPRESSED_SIZE=1GB
LOREDOCK_CODE_SNAPSHOT_MAX_COMPRESSION_RATIO=100
LOREDOCK_CODE_SNAPSHOT_MAX_SEARCH_SNIPPET_CHARS=2000
