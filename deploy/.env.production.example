# LoreDock 生产部署环境变量模板
# 复制为 deploy/.env.production 并按说明填真值（chmod 600，不入 git）。
# 标记「从本地 .env 复制」的项，请直接沿用本地已正确生成的值；其余项按需重新生成。
# 注意：bcrypt 哈希含 $ 字符，本文件仅供 docker compose --env-file / env_file 插值读取，严禁 source 执行。
# ⚠️ 任何值里出现字面 $ 时，必须写成 $$（例如 bcrypt 哈希 $2b$12$... 要写成 $$2b$$12$$...），
#    否则 docker compose 会把 $xxx 当成变量展开成空串，容器拿到的值会被损坏。

# ============ 部署基础 ============
# 你的域名（必须已把 DNS A 记录指向这台服务器）
SSL_DOMAIN=www.your-domain.cn
# certbot 注册邮箱（Let's Encrypt 通知用）；仅 internal TLS 模式需要
ACME_EMAIL=admin@your-domain.cn

# TLS 终结方式：
#   internal（默认）= 本 nginx 终结 TLS（占用 80/443）+ certbot 签发/续期；
#   external        = 80/443 已被宿主机或面板反代占用（如 1Panel openresty 跑博客），
#                     本 nginx 只提供 HTTP，由上游反代（域名/HTTPS/证书）终结 TLS。
# 最常见的 1Panel 服务器请用 external，并配合下方 WEB 端口映射。
LOREDOCK_TLS_MODE=internal

# 镜像标签：默认本地标签；走 registry push 时改为 <registry>/<账号>/loredock-backend:0.1.0 等
LOREDOCK_BACKEND_IMAGE=loredock-backend:0.1.0
LOREDOCK_FRONTEND_IMAGE=loredock-frontend:0.1.0

# nginx 宿主端口映射：internal 用 80/443；external 用普通高位（如 8082），由 1Panel 反代转发到该端口。
# 一个 1Panel 服务器示例：LOREDOCK_TLS_MODE=external，LOREDOCK_WEB_HTTP_PORT=8082，HTTPS 端口填空闲高位即可。
LOREDOCK_WEB_HTTP_PORT=80
LOREDOCK_WEB_HTTPS_PORT=443

# 后端 JVM 堆上限（单机内存有限时收紧；embedding 模型冷初始化另需约 512MiB 原生内存）
JAVA_TOOL_OPTIONS=-Xmx768m -Xms128m -XX:MaxMetaspaceSize=256m -XX:+ExitOnOutOfMemoryError

# ============ 数据库（两套键必须对应一致） ============
# 以下 6 个保持不变即可，密码建议换成全新强密码（与本地开发库无关，数据由迁移 dump 恢复）
POSTGRES_DB=loredock
POSTGRES_USER=loredock
POSTGRES_PASSWORD=replace_with_strong_db_password
LOREDOCK_DB_URL=jdbc:postgresql://database:5432/loredock
LOREDOCK_DB_USER=loredock
LOREDOCK_DB_PASSWORD=replace_with_strong_db_password

# ============ 存储与 embedding 模型 ============
# 相对后端容器 WORKDIR=/app；models 与 data/objects 由 compose bind mount 挂入
LOREDOCK_STORAGE_ROOT=./data/objects
LOREDOCK_KNOWLEDGE_EMBEDDING_MODEL_ID=BAAI/bge-small-zh-v1.5
LOREDOCK_KNOWLEDGE_EMBEDDING_MODEL_URI=file:./models/bge-small-zh-v1.5/model.onnx
LOREDOCK_KNOWLEDGE_EMBEDDING_TOKENIZER_URI=file:./models/bge-small-zh-v1.5/tokenizer.json
# 锁定产物 SHA-256：请从本地 .env 原样复制（须与上传的模型文件实际哈希一致，否则后端拒绝启动）
LOREDOCK_KNOWLEDGE_EMBEDDING_MODEL_SHA256=3a40c6eab3abdf2bd07651031a36038c2dfaf4ebb8d62ddc78f2324b2ff4389a

# ============ Web 账号 ============
# 用户名与显示名可自定；密码只允许 BCrypt 哈希。可复制本地 .env 的哈希（沿用同一密码），
# 或用 `htpasswd -bnBC 12 "" <新密码> | tr -d ':\n'` 生成新的。
LOREDOCK_ADMIN_USERNAME=replace_with_admin_username
LOREDOCK_ADMIN_DISPLAY_NAME=管理员
LOREDOCK_ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# ============ MCP（公网暴露，靠高熵 Bearer token 鉴权） ============
# 可从本地 .env 复制，或重新生成一段高熵随机串（建议 `openssl rand -hex 32`）
LOREDOCK_MCP_ENABLED=true
LOREDOCK_MCP_READ_TOKEN=replace_with_high_entropy_read_token
LOREDOCK_MCP_WRITE_TOKEN=replace_with_high_entropy_write_token

# ============ Agent（默认关闭；上线若用知识整理必须开启） ============
# 注意：Agent 模型配置不要留占位！直接复制本地 .env 的 LOREDOCK_AGENT_* 全套到这里
# （或用 bash deploy/base/make-env.sh 一键复用本地 .env）。
# 只改了 ENABLED/CHAT_PROVIDER 而没带真实 API Key → 后端报 AGENT_MODEL_UNAVAILABLE。
# 启用时把 LOREDOCK_AGENT_CHAT_PROVIDER 设为 openai 并注入密钥；MVP 不允许请求覆盖模型/端点
LOREDOCK_AGENT_ENABLED=true
LOREDOCK_AGENT_CHAT_PROVIDER=openai
LOREDOCK_AGENT_MODEL_BASE_URL=https://api.deepseek.com
LOREDOCK_AGENT_MODEL_NAME=deepseek-v4-flash
LOREDOCK_AGENT_MODEL_API_KEY=replace_with_deployment_secret

# ============ 本机演练用（服务器生产可不改） ============
# 本地起 prod compose 演练时把 80/443 映射到非特权端口，并在 LOREDOCK_TLS_MODE=internal 下用占位证书：
#   LOREDOCK_WEB_HTTP_PORT=8081
#   LOREDOCK_WEB_HTTPS_PORT=8443
# （演练结束时 docker compose down -v 清理独立 prod 卷，不影响本地开发库）